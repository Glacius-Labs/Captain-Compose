[Unit]
Description=Captain Compose MQTT deployment agent
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User={{ captain_compose_user }}
Group={{ captain_compose_group }}
SupplementaryGroups=docker
Environment=DOCKER_CONFIG={{ captain_compose_config_directory }}/docker
WorkingDirectory={{ captain_compose_state_directory }}
ExecStart={{ captain_compose_install_prefix }}/captain-compose-mqtt --config {{ captain_compose_config_directory }}/config.yaml
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ captain_compose_state_directory }}
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
