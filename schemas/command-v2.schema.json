{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glacius-labs.github.io/captain-compose/schemas/command-v2.schema.json",
  "title": "Captain Compose MQTT command v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "type", "data"],
  "properties": {
    "id": {"type": "string", "format": "uuid", "not": {"pattern": "^00000000-0000-0000-0000-000000000000$"}},
    "version": {"const": 2},
    "type": {"enum": ["create", "remove", "plan", "status", "inspect", "doctor", "revert", "result"]},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$"},
    "data": {"$ref": "#/$defs/request"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"enum": ["create", "plan"]}}, "required": ["type"]}, "then": {"properties": {"data": {"required": ["name", "payload"]}}}},
    {"if": {"properties": {"type": {"enum": ["remove", "inspect"]}}, "required": ["type"]}, "then": {"properties": {"data": {"required": ["name"]}}}},
    {"if": {"properties": {"type": {"enum": ["create", "remove", "plan", "inspect", "revert"]}}, "required": ["type"]}, "then": {"properties": {"data": {"properties": {"name": {"$ref": "#/$defs/name"}}}}}},
    {"if": {"properties": {"type": {"const": "remove"}}, "required": ["type"]}, "then": {"properties": {"data": {"properties": {"expected_revision": {"$ref": "#/$defs/revision"}}}}}},
    {"if": {"properties": {"type": {"const": "doctor"}}, "required": ["type"]}, "then": {"properties": {"data": {"maxProperties": 0}}}},
    {"if": {"properties": {"type": {"const": "status"}}, "required": ["type"]}, "then": {"properties": {"data": {"maxProperties": 1, "properties": {"name": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/name"}]}}}}}},
    {"if": {"properties": {"type": {"not": {"enum": ["create", "plan"]}}}, "required": ["type"]}, "then": {"properties": {"data": {"not": {"required": ["payload"]}}}}},
    {"if": {"properties": {"type": {"not": {"enum": ["create", "remove", "plan", "revert"]}}}, "required": ["type"]}, "then": {"properties": {"data": {"not": {"required": ["expected_revision"]}}}}},
    {"if": {"properties": {"type": {"not": {"const": "revert"}}}, "required": ["type"]}, "then": {"properties": {"data": {"not": {"anyOf": [{"required": ["revision"]}, {"required": ["allow_data_risk"]}]}}}}},
    {"if": {"properties": {"type": {"not": {"const": "result"}}}, "required": ["type"]}, "then": {"properties": {"data": {"not": {"required": ["request_id"]}}}}},
    {"if": {"properties": {"type": {"const": "result"}}, "required": ["type"]}, "then": {"properties": {"data": {"required": ["request_id"], "maxProperties": 1}}}},
    {"if": {"properties": {"type": {"enum": ["plan", "status", "inspect", "doctor", "result"]}}, "required": ["type"]}, "then": {"not": {"required": ["expires_at"]}}},
    {"if": {"properties": {"type": {"const": "revert"}}, "required": ["type"]}, "then": {"properties": {"data": {"required": ["name", "revision", "expected_revision", "allow_data_risk"], "properties": {"expected_revision": {"$ref": "#/$defs/revision"}, "allow_data_risk": {"const": true}}}}}}
  ],
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/name"}]},
        "payload": {"type": "string", "contentEncoding": "base64", "minLength": 4, "maxLength": 1398104, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$"},
        "expected_revision": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/revision"}]},
        "revision": {"$ref": "#/$defs/revision"},
        "allow_data_risk": {"type": "boolean"},
        "request_id": {"type": "string", "format": "uuid", "not": {"pattern": "^00000000-0000-0000-0000-000000000000$"}}
      }
    }
  }
}
